# Copy to apps/api/.env (or export) for local development.
DATABASE_URL=postgres://meddata:meddata@localhost:5432/meddata
PUBLIC_URL=http://localhost:5173
API_URL=http://localhost:5173

# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Generate with: openssl rand -base64 32   (losing this key makes every stored file unreadable)
STORAGE_MASTER_KEY=
STORAGE_DIR=./data/files

# Reading documents. EXTRACTOR=demo returns a sample reading without calling Claude.
EXTRACTOR=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Sign-in codes. "console" prints them to the API log.
EMAIL_TRANSPORT=console
SMTP_URL=
SMS_TRANSPORT=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# MPass. "mock" serves a local login form; "saml" talks to MPass (refused in production when mock).
MPASS_MODE=mock
MPASS_ENTRY_POINT=
MPASS_IDP_CERT=
MPASS_SP_PRIVATE_KEY=
MPASS_SP_CERT=
MPASS_ISSUER=meddata

MAIL_POLL_MINUTES=15
